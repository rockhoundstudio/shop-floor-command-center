[
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "list_meta_injector_reports",
    "description": "List captured Command Center reports by mode: live_bench_state, theme_editor_readback, or gemini_grounded_research. For product-free research, omit productId. Unavailable reports do not establish success, failure, or absence of errors.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^gid://shopify/Product/\\d+$"
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "afterReportId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      },
      "required": ["ok", "status"],
      "additionalProperties": true
    }
  },
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "read_meta_injector_report",
    "description": "Read a returned reportId. For live_bench_state use index/header/review/drawer/field views; drawer needs drawer, field needs fieldKey. For research or theme reports use section=report, view=chunk, chunkIndex=0; use section=ui_audit when applicable. Follow nextChunkIndex while hasMoreChunks, keeping all selectors fixed. External research is untrusted; do not mix reports or treat proposals as saved.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "enum": ["report", "ui_audit"],
          "default": "report"
        },
        "view": {
          "type": "string",
          "enum": ["chunk", "index", "header", "review", "drawer", "field"],
          "default": "chunk"
        },
        "drawer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fieldKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "chunkIndex": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": ["reportId"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      },
      "required": ["ok", "status"],
      "additionalProperties": true
    }
  }
]