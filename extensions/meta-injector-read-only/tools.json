[
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "list_meta_injector_reports",
    "description": "Lists captured temporary Meta Injector reports with product, session, revision, capture identity, pagination and UI-audit availability. Use mode='live_bench_state' for bench snapshots. Unavailable reports do not prove successful tests or absence of errors.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^gid://shopify/Product/\\d+$"
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "afterReportId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      },
      "required": ["ok", "status"],
      "additionalProperties": true
    }
  },
  {
    "$schema": "https://extensions.shopifycdn.com/shopifycloud/schemas/v1/tool.json",
    "name": "read_meta_injector_report",
    "description": "Reads an exact reportId. For live_bench_state use view=index, header, review, drawer or field. Drawer requires drawer; field requires fieldKey. Description Review is a separate drawer. Omit unused drawer/fieldKey. For ui_audit use chunk or omit view. Follow nextChunkIndex while hasMoreChunks, keeping reportId, section, view, drawer and fieldKey unchanged. Never mix snapshots or treat proposals as saved.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "enum": ["report", "ui_audit"],
          "default": "report"
        },
        "view": {
          "type": "string",
          "enum": ["chunk", "index", "header", "review", "drawer", "field"],
          "default": "chunk"
        },
        "drawer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fieldKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "chunkIndex": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": ["reportId"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      },
      "required": ["ok", "status"],
      "additionalProperties": true
    }
  }
]
