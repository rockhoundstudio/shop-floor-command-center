generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoneCache {
  id        String   @id @default(cuid())
  stoneName String   @unique
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DwellRule {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  url       String
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuSetting {
  id         String   @id @default(cuid())
  menuHandle String   @unique
  isLocked   Boolean  @default(false)
  autoSync   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model MenuHistory {
  id         String   @id @default(cuid())
  menuHandle String
  message    String
  createdAt  DateTime @default(now())
}

model StoneProfile {
  id              String   @id @default(cuid())
  stoneName       String   @unique
  baseMineralName String?
  colorPattern    String?
  authenticity    String?
  rarity          String?
  crystalSystem   String?
  geologicalEra   String?
  mineralClass    String?
  rockComposition String?
  rockFormation   String?
  hardness        String?
  luster          String?
  fracture        String?
  cleavage        String?
  specificGravity String?
  diaphaneity     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DbProfile {
  id                    String   @id @default(uuid())
  productGid            String   @unique
  title                 String
  googleColorPattern    String?
  googleAuthenticity    String?
  googleRarity          String?
  googleCrystalSystem   String?
  googleGeologicalEra   String?
  googleMineralClass    String?
  googleRockComposition String?
  googleRockFormation   String?
  storeHardness         String?
  storeLuster           String?
  storeFracture         String?
  storeCleavage         String?
  storeSpecificGravity  String?
  storeDiaphaneity      String?
  storeOriginLocation   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model TaxonomyGid {
  id        String   @id @default(cuid())
  category  String
  term      String
  gid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, term])
}
