datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model StoneCache {
  id        String   @id @default(cuid())
  stoneName String   @unique @map("stone_name")
  data      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model DwellRule {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  url       String
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuSetting {
  id         String   @id @default(cuid())
  menuHandle String   @unique
}

model StoneProfile {
  id              String   @id @default(cuid())
  stoneName       String   @unique @map("stone_name")
  baseMineralName String?  @map("base_mineral_name")
  colorPattern    String?  @map("color_pattern")
  authenticity    String?
  rarity          String?
  crystalSystem   String?  @map("crystal_system")
  geologicalEra   String?  @map("geological_era")
  mineralClass    String?  @map("mineral_class")
  rockComposition String?  @map("rock_composition")
  rockFormation   String?  @map("rock_formation")
  hardness        String?
  luster          String?
  fracture        String?
  cleavage        String?
  specificGravity String?  @map("specific_gravity")
  diaphaneity     String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
}

model TaxonomyGid {
  id        String   @id @default(cuid())
  category  String
  term      String
  gid       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, term], name: "category_term")
}
